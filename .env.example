# HTTP server port
SERVER_PORT=8080

# MySQL connection
DB_HOST=127.0.0.1:3306
DB_USER=root
DB_PASSWORD=your_db_password_here
DB_NAME=jblcf_attendance

# JWT signing secret — REQUIRED. Must be a long random string (min 32 chars).
# Generate one with: openssl rand -hex 32
# The server will refuse to start if this is blank or still the placeholder.
JWT_SECRET=CHANGE_ME_use_openssl_rand_hex_32

# Comma-separated list of allowed CORS origins.
# In development, add your Vite dev server (default: http://localhost:5173).
# In production, use your actual frontend domain.
# Leave blank to disallow all cross-origin requests (same-origin only).
CORS_ALLOWED_ORIGINS=http://localhost:5173
